# Copy to `.env` for local development (git-ignored). On Render these are set in the dashboard - never commit values.
# Full reference: plan.md §12.1 and backend/app/modules/core/spec.md §8.

ENV=dev
LOG_LEVEL=INFO

# Supabase -> Project Settings -> Database -> Connection string -> "Session pooler" (IPv4, port 5432)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_SSL=require

# Seeded single account (M1). Hash with: uv run python -m app.modules.auth.hash_password
OWNER_EMAIL=you@example.com
OWNER_PASSWORD_HASH=

# >= 32 random characters:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_TTL_DAYS=30

# Format "<id>:<base64 of 32 random bytes>":  python -c "import os,base64; print('1:'+base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEYS=
ENCRYPTION_ACTIVE_KEY_ID=1

# Optional (the app degrades gracefully without them)
OPENROUTER_API_KEY=
GROQ_API_KEY=
BREVO_API_KEY=
EMAIL_FROM=
