<mxfile host="app.diagrams.net">
  <diagram id="data-model" name="Data Model">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;Personal Daily Assistant — Data Model (Supabase Postgres)&lt;/b&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;: 🔒 = encrypted by the FastAPI crypto module (AES-256-GCM) before write · PK primary key · FK foreign key · all timestamps UTC timestamptz · every table also has created_at / updated_at&lt;br&gt;Colours = owning module: grey core/auth · yellow schedule · purple day_cycle · blue tasks · green feasibility · orange assistant · red reports/email · white ops logs" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="1100" width="1280" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="t_user" value="&lt;b&gt;user_account&lt;/b&gt; &lt;i&gt;(auth)&lt;/i&gt;&lt;hr&gt;PK id uuid&lt;br&gt;email text UNIQUE&lt;br&gt;password_hash text (argon2id)&lt;br&gt;token_version int&lt;br&gt;last_login_at timestamptz&lt;br&gt;&lt;i&gt;exactly one row&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="280" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="t_settings" value="&lt;b&gt;app_settings&lt;/b&gt; &lt;i&gt;(core)&lt;/i&gt;&lt;hr&gt;PK id uuid&lt;br&gt;timezone text (IANA)&lt;br&gt;reminder_offsets_min int[] = {60,30}&lt;br&gt;🔒 report_email text NULL&lt;br&gt;week_start smallint = 1 (Mon)&lt;br&gt;&lt;i&gt;exactly one row&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="250" width="280" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="t_block" value="&lt;b&gt;fixed_schedule_block&lt;/b&gt; &lt;i&gt;(schedule)&lt;/i&gt;&lt;hr&gt;PK id uuid&lt;br&gt;weekday smallint (0=Mon..6=Sun)&lt;br&gt;start_local time&lt;br&gt;end_local time (may cross midnight)&lt;br&gt;🔒 label text&lt;br&gt;kind enum (work, sleep, commute, meal, personal, other)&lt;br&gt;is_hard bool&lt;br&gt;active bool" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="280" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="t_cal" value="&lt;b&gt;calendar_event&lt;/b&gt; &lt;i&gt;(schedule)&lt;/i&gt;&lt;hr&gt;PK id uuid&lt;br&gt;day_date date (replaced per date on import)&lt;br&gt;external_id text&lt;br&gt;start_at timestamptz&lt;br&gt;end_at timestamptz&lt;br&gt;all_day bool&lt;br&gt;🔒 title text&lt;br&gt;imported_at timestamptz" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="40" y="640" width="280" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="t_day" value="&lt;b&gt;day_session&lt;/b&gt; &lt;i&gt;(day_cycle)&lt;/i&gt;&lt;hr&gt;PK id uuid&lt;br&gt;local_date date UNIQUE&lt;br&gt;opened_at timestamptz&lt;br&gt;closed_at timestamptz NULL&lt;br&gt;close_mode enum (user, auto_midnight)&lt;br&gt;state enum (open, closing, closed)&lt;br&gt;FK daily_report_id → report NULL&lt;br&gt;FK weekly_report_id → report NULL" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="380" y="80" width="280" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="t_task" value="&lt;b&gt;task&lt;/b&gt; &lt;i&gt;(tasks)&lt;/i&gt;&lt;hr&gt;PK id uuid&lt;br&gt;local_date date (matches day_session.local_date)&lt;br&gt;FK template_id → task_template NULL (null = one-time)&lt;br&gt;🔒 title text&lt;br&gt;🔒 notes text&lt;br&gt;category text&lt;br&gt;start_at timestamptz NULL&lt;br&gt;estimate_min int NULL&lt;br&gt;predicted_end_at timestamptz NULL&lt;br&gt;prediction_method text NULL&lt;br&gt;actual_end_at timestamptz NULL&lt;br&gt;actual_end_source enum (notification_action, manual, eod_resolution)&lt;br&gt;status enum (planned, completed, postponed, cancelled, cant_do, missed)&lt;br&gt;🔒 status_reason text NULL&lt;br&gt;FK postponed_to_task_id → task NULL&lt;br&gt;FK feasibility_id → feasibility_assessment NULL&lt;br&gt;feasibility_overridden bool&lt;br&gt;created_via enum (form, chat, template)&lt;br&gt;check_response enum (done, not_yet) NULL&lt;br&gt;UNIQUE (local_date, template_id)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="380" y="300" width="280" height="400" as="geometry"/>
        </mxCell>
        <mxCell id="t_tse" value="&lt;b&gt;task_status_event&lt;/b&gt; &lt;i&gt;(tasks, append-only)&lt;/i&gt;&lt;hr&gt;PK id uuid&lt;br&gt;FK task_id → task&lt;br&gt;from_status enum&lt;br&gt;to_status enum&lt;br&gt;at timestamptz&lt;br&gt;source enum (app, notification, chat, eod, system)&lt;br&gt;🔒 reason text NULL" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="380" y="740" width="280" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="t_tpl" value="&lt;b&gt;task_template&lt;/b&gt; &lt;i&gt;(tasks, recurring)&lt;/i&gt;&lt;hr&gt;PK id uuid&lt;br&gt;🔒 title text&lt;br&gt;🔒 notes text&lt;br&gt;category text&lt;br&gt;start_local time NULL&lt;br&gt;recurrence jsonb (daily or weekly + byweekday)&lt;br&gt;default_estimate_min int NULL&lt;br&gt;active bool" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="720" y="80" width="280" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="t_feas" value="&lt;b&gt;feasibility_assessment&lt;/b&gt; &lt;i&gt;(feasibility)&lt;/i&gt;&lt;hr&gt;PK id uuid&lt;br&gt;🔒 draft json (task draft assessed)&lt;br&gt;deterministic jsonb (overlaps, free_min, load)&lt;br&gt;jev_answers jsonb (nouls, scores, choices)&lt;br&gt;score real 0..1&lt;br&gt;feasible_noul real 0..1&lt;br&gt;verdict enum (go, caution, no_go)&lt;br&gt;recommended_action enum (proceed, reschedule, split, shorten, drop)&lt;br&gt;🔒 suggestion text&lt;br&gt;engine enum (jev, groq_fallback, deterministic_only)&lt;br&gt;degraded bool&lt;br&gt;latency_ms int" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="720" y="300" width="280" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="t_chat" value="&lt;b&gt;chat_message&lt;/b&gt; &lt;i&gt;(assistant)&lt;/i&gt;&lt;hr&gt;PK id uuid&lt;br&gt;FK day_id → day_session&lt;br&gt;role enum (user, assistant)&lt;br&gt;🔒 content text&lt;br&gt;intent text NULL&lt;br&gt;intent_confidence real NULL&lt;br&gt;in_scope_noul real NULL&lt;br&gt;🔒 proposal json NULL" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="720" y="590" width="280" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="t_report" value="&lt;b&gt;report&lt;/b&gt; &lt;i&gt;(reports)&lt;/i&gt;&lt;hr&gt;PK id uuid&lt;br&gt;kind enum (daily, weekly)&lt;br&gt;period_start date&lt;br&gt;period_end date&lt;br&gt;status enum (pending, ready, failed)&lt;br&gt;🔒 metrics json&lt;br&gt;🔒 narrative text&lt;br&gt;generated_at timestamptz NULL&lt;br&gt;emailed_at timestamptz NULL" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1060" y="80" width="280" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="t_asset" value="&lt;b&gt;report_asset&lt;/b&gt; &lt;i&gt;(reports)&lt;/i&gt;&lt;hr&gt;PK id uuid&lt;br&gt;FK report_id → report&lt;br&gt;name text (e.g. status_donut.png, report.pdf)&lt;br&gt;mime text&lt;br&gt;🔒 blob bytea (pruned after 90 days)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1060" y="310" width="280" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="t_email" value="&lt;b&gt;email_log&lt;/b&gt; &lt;i&gt;(email)&lt;/i&gt;&lt;hr&gt;PK id uuid&lt;br&gt;FK report_id → report&lt;br&gt;provider text (brevo, smtp)&lt;br&gt;🔒 recipient text&lt;br&gt;status enum (sent, failed)&lt;br&gt;provider_message_id text NULL&lt;br&gt;error text NULL" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1060" y="480" width="280" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="t_ai" value="&lt;b&gt;ai_call_log&lt;/b&gt; &lt;i&gt;(ai_gateway, no personal text)&lt;/i&gt;&lt;hr&gt;PK id uuid&lt;br&gt;provider text (jev, groq, openrouter)&lt;br&gt;model text&lt;br&gt;purpose text (feasibility, intent, narrative...)&lt;br&gt;status text&lt;br&gt;latency_ms int&lt;br&gt;input_tokens int&lt;br&gt;output_tokens int&lt;br&gt;cost_usd numeric&lt;br&gt;error_code text NULL" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1060" y="680" width="280" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="r_task_day" value="local_date (logical, no FK)" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;startArrow=ERmany;endArrow=ERzeroToOne;startFill=0;endFill=0;fontSize=10;dashed=1;" edge="1" parent="1" source="t_task" target="t_day">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="r_task_tpl" value="template_id" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;startArrow=ERmany;endArrow=ERzeroToOne;startFill=0;endFill=0;fontSize=10;exitX=1;exitY=0.1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_task" target="t_tpl">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="r_task_feas" value="feasibility_id" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;startArrow=ERzeroToOne;endArrow=ERzeroToOne;startFill=0;endFill=0;fontSize=10;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_task" target="t_feas">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="r_task_self" value="postponed_to_task_id" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;startArrow=ERzeroToOne;endArrow=ERzeroToOne;startFill=0;endFill=0;fontSize=10;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.9;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_task" target="t_task">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="345" y="600"/>
              <mxPoint x="345" y="660"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="r_tse_task" value="task_id" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;startArrow=ERmany;endArrow=ERmandOne;startFill=0;endFill=0;fontSize=10;" edge="1" parent="1" source="t_tse" target="t_task">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="r_chat_day" value="day_id" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;startArrow=ERmany;endArrow=ERmandOne;startFill=0;endFill=0;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_chat" target="t_day">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="860" y="800"/>
              <mxPoint x="690" y="800"/>
              <mxPoint x="690" y="224"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="r_day_report" value="daily_report_id / weekly_report_id" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;startArrow=ERzeroToMany;endArrow=ERzeroToOne;startFill=0;endFill=0;fontSize=10;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_day" target="t_report">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="520" y="65"/>
              <mxPoint x="1200" y="65"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="r_asset_report" value="report_id" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;startArrow=ERmany;endArrow=ERmandOne;startFill=0;endFill=0;fontSize=10;" edge="1" parent="1" source="t_asset" target="t_report">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="r_email_report" value="report_id" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;startArrow=ERmany;endArrow=ERmandOne;startFill=0;endFill=0;fontSize=10;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_email" target="t_report">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1370" y="528"/>
              <mxPoint x="1370" y="175"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="t_override" value="&lt;b&gt;schedule_block_override&lt;/b&gt; &lt;i&gt;(schedule)&lt;/i&gt;&lt;hr&gt;PK id uuid&lt;br&gt;local_date date&lt;br&gt;FK block_id → fixed_schedule_block (cascade)&lt;br&gt;action enum (skip, adjust)&lt;br&gt;start_local time NULL&lt;br&gt;end_local time NULL&lt;br&gt;is_hard bool NULL&lt;br&gt;UNIQUE (local_date, block_id)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="40" y="910" width="280" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="r_override_block" value="block_id" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;startArrow=ERmany;endArrow=ERmandOne;startFill=0;endFill=0;fontSize=10;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_override" target="t_block">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="20" y="961"/>
              <mxPoint x="20" y="515"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="n_cal" value="calendar_event links to a day by day_date (no FK) — imported only with per-day consent" style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=10;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="40" y="840" width="280" height="50" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
